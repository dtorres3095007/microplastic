        "dotenv",
        "dropna",
        "figsize",
        "georeferenced",
        "iterrows",
        "microplastic",
        "NDCI",
        "NDPI",
        "NDVI",
        "NDWI",
        "REDEDGE",
        "reproject",
        "rowcol",
        "SWIR",
        "zipf"
    ]
}